{
  "name": "starisian-technologies/sparxstar-access-manager",
  "description": "A WordPress MU-plugin that loads Secure Custom Field options and enforces runtime rules with multi-site support",
  "type": "wordpress-muplugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Starisian Technologies",
      "email": "info@starisian.tech"
    }
  ],
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.0 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2"
  },
  "autoload": {
    "psr-4": {
      "StarisianTechnologies\\SparxstarAccessManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StarisianTechnologies\\SparxstarAccessManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
